# Copy to .env.runtime (ignored). Set absolute paths; never commit real secrets.
# NEXTWISE_ARTIFACTS_DIR is a directory containing the original data/ tree.
NEXTWISE_ARTIFACTS_DIR=
# Existing data/memory/hmem, including both store directories and all run files.
NEXTWISE_HMEM_DIR=
NEXTWISE_ZETARIS_SECRET_FILE=
NEXTWISE_PUBLISHED_PORT=8765
# These defaults address existing services on the Docker host; verify reachability.
NEXTWISE_ZETARIS_URL=http://host.docker.internal:8888
NEXTWISE_ZETARIS_ORG_ID=1
NEXTWISE_METERLESS_URL=http://host.docker.internal:8088
NEXTWISE_MODEL=meterless/auto
NEXTWISE_REQUIRE_METERLESS=false
NEXTWISE_DEPENDENCY_TIMEOUT=3
