# Public template only. Copy privately to .env.runtime.remote (already ignored).
# Restore into NEW remote paths; never point these at the original local stores.
NEXTWISE_ARTIFACTS_DIR=/srv/nextwise/artifacts
NEXTWISE_HMEM_DIR=/srv/nextwise/hmem
NEXTWISE_ZETARIS_SECRET_FILE=/srv/nextwise/secrets/zetaris_api_key
NEXTWISE_TAVILY_SECRET_FILE=/srv/nextwise/secrets/tavily_api_key
NEXTWISE_METERLESS_SECRET_FILE=/srv/nextwise/secrets/meterless_token
# Opt in only after replacements, route, model and spending approval are ready.
NEXTWISE_PROJECT_PROVIDERS_ENABLED=false
NEXTWISE_PROJECT_SEARCH_LIMIT=2
NEXTWISE_PROJECT_ASSESSMENT_LIMIT=4
NEXTWISE_ZETARIS_URL=http://127.0.0.1:8888
NEXTWISE_ZETARIS_ORG_ID=1
# Reverse SSH tunnel from the existing supported Meterless host.
NEXTWISE_METERLESS_URL=http://127.0.0.1:18088
NEXTWISE_MODEL=meterless/auto
NEXTWISE_REQUIRE_METERLESS=true
NEXTWISE_DEPENDENCY_TIMEOUT=15
